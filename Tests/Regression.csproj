<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OmenMon.Regression</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>11.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>Bin</OutputPath>
    <IntermediateOutputPath>Obj</IntermediateOutputPath>
    <AppBinDir Condition="'$(AppBinDir)' == ''">..\Bin</AppBinDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OmenMon"><HintPath>$(AppBinDir)\OmenMon.exe</HintPath><Private>true</Private></Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Compile Include="Regression.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
</Project>
